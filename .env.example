# ─────────────────────────────────────────────────────────────
# 환경변수 예시 파일 (.env.example)
#
# 사용법:
#   1) 이 파일을 복사해서 같은 폴더에 ".env.local" 이라는 이름으로 저장합니다.
#   2) ".env.local" 안의 빈칸(= 뒤)에 실제 값을 채웁니다.
#   3) ".env.local" 은 .gitignore 에 의해 GitHub에 올라가지 않습니다.
#      → 실제 비밀 값은 오직 .env.local (그리고 나중에 Vercel 설정 화면)에만 넣습니다.
#   ※ 이 예시 파일에는 절대 실제 값을 적지 마세요. (이 파일은 GitHub에 올라갑니다)
# ─────────────────────────────────────────────────────────────

# [Supabase] 프로젝트 주소
#   Supabase 대시보드 → Project Settings → Data API (또는 API) → "Project URL"
#   예: https://abcdefghijklmn.supabase.co
SUPABASE_URL=

# [Supabase] 서버 전용 비밀 키 (★ 가장 중요한 비밀 값)
#   Supabase 대시보드 → Project Settings → API Keys
#   - 새 화면: "Secret keys" 의 sb_secret_... 로 시작하는 키
#   - 예전 화면: "service_role" 키
#   이 키는 데이터베이스를 마음대로 읽고 쓸 수 있으므로 서버에서만 사용합니다.
SUPABASE_SECRET_KEY=

# [로그인] 로그인 쿠키를 서명하는 비밀 값 (선택 사항)
#   비워 두면 SUPABASE_SECRET_KEY 에서 자동으로 만들어 씁니다. 따로 넣을 필요는 없습니다.
SESSION_SECRET=

# [자동 추첨] Vercel Cron 이 추첨 주소를 부를 때 쓰는 비밀 값
#   8단계에서 안내합니다. 지금은 비워 두어도 됩니다.
CRON_SECRET=

# [비상 복구] 첫 관리자 만들기 / 관리자가 모두 로그인할 수 없을 때 복구하는 비밀 값 (16자 이상)
#   본인이 직접 정한 긴 문장을 넣습니다. (예: 띄어쓰기 포함 20자 이상의 나만 아는 문장)
#   사이트의 /emergency 주소에서 이 값을 입력하면 관리자를 만들거나 복구할 수 있습니다.
EMERGENCY_KEY=
